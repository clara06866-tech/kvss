<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Khmer Victor Security Service | 24/7 Protection, Phnom Penh</title>
<meta name="description" content="Khmer Victor Security Service Co., Ltd — licensed private security guards, armed guards, bodyguards and security training in Cambodia since 2016.">
<link rel="icon" href="data:image/png;base64,">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600;700&family=Inter:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root{
    --ink:#0b1530;
    --ink-2:#101c40;
    --red:#a11d2b;
    --red-2:#c22636;
    --gold:#cf9d34;
    --paper:#f3f1ea;
    --paper-dim:#e7e4da;
    --slate:#8892ab;
    --line: rgba(243,241,234,0.14);
    --line-dark: rgba(11,21,48,0.12);
    --display: 'Oswald', sans-serif;
    --body: 'Inter', sans-serif;
    --mono: 'IBM Plex Mono', monospace;
    --ease: cubic-bezier(.16,.84,.44,1);
  }
  *{margin:0;padding:0;box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    background:var(--paper);
    color:var(--ink);
    font-family:var(--body);
    -webkit-font-smoothing:antialiased;
    overflow-x:hidden;
  }
  img{max-width:100%;display:block;}
  a{color:inherit;text-decoration:none;}
  .wrap{max-width:1240px;margin:0 auto;padding:0 40px;}
  @media(max-width:720px){.wrap{padding:0 22px;}}

  .eyebrow{
    font-family:var(--mono);
    font-size:12px;
    letter-spacing:.14em;
    text-transform:uppercase;
    display:inline-flex;
    align-items:center;
    gap:10px;
    color:var(--gold);
  }
  .eyebrow::before{content:"";width:22px;height:1px;background:var(--gold);display:inline-block;}

  h1,h2,h3{font-family:var(--display);font-weight:600;letter-spacing:-.01em;line-height:1.04;}

  /* ---------- reveal ---------- */
  .reveal{opacity:0;transform:translateY(28px);transition:opacity .8s var(--ease),transform .8s var(--ease);}
  .reveal.in{opacity:1;transform:translateY(0);}

  /* ---------- dispatch ticker ---------- */
  .ticker{
    background:var(--ink);
    color:var(--slate);
    border-bottom:1px solid var(--line);
    overflow:hidden;
    white-space:nowrap;
    height:34px;
    display:flex;
    align-items:center;
    position:relative;
    z-index:60;
  }
  .ticker__track{
    display:inline-flex;
    align-items:center;
    animation: ticker 32s linear infinite;
    font-family:var(--mono);
    font-size:11px;
    letter-spacing:.12em;
  }
  .ticker__track span{padding:0 22px;text-transform:uppercase;display:inline-flex;align-items:center;gap:22px;}
  .ticker__track span::after{content:"—";color:var(--red-2);}
  .dot-live{width:6px;height:6px;border-radius:50%;background:#3ddc84;display:inline-block;box-shadow:0 0 0 3px rgba(61,220,132,.18);}
  @keyframes ticker{from{transform:translateX(0);}to{transform:translateX(-50%);}}

  /* ---------- nav ---------- */
  header{
    position:sticky;top:0;z-index:50;
    background:rgba(11,21,48,.86);
    backdrop-filter:blur(10px);
    border-bottom:1px solid var(--line);
  }
  .nav{
    display:flex;align-items:center;justify-content:space-between;
    padding:16px 40px;
  }
  @media(max-width:720px){.nav{padding:14px 22px;}}
  .brand{display:flex;align-items:center;gap:12px;color:var(--paper);}
  .brand img{height:38px;width:auto;}
  .brand-text{font-family:var(--display);font-size:16px;letter-spacing:.03em;line-height:1.15;}
  .brand-text b{display:block;font-size:15px;color:var(--paper);}
  .brand-text small{display:block;font-family:var(--mono);font-size:9.5px;letter-spacing:.16em;color:var(--gold);text-transform:uppercase;margin-top:2px;}
  nav.links{display:flex;align-items:center;gap:34px;}
  nav.links a{
    color:var(--slate);font-size:13px;letter-spacing:.03em;
    text-transform:uppercase;font-family:var(--mono);
    transition:color .25s;
  }
  nav.links a:hover{color:var(--paper);}
  .nav-cta{
    background:var(--red);color:#fff;padding:10px 20px;border-radius:2px;
    font-family:var(--mono);font-size:12px;letter-spacing:.08em;text-transform:uppercase;
    border:1px solid var(--red);transition:background .25s,border-color .25s;
  }
  .nav-cta:hover{background:transparent;border-color:var(--red-2);}
  .burger{display:none;flex-direction:column;gap:5px;background:none;border:0;cursor:pointer;}
  .burger span{width:22px;height:2px;background:var(--paper);}
  @media(max-width:900px){
    nav.links{display:none;}
    .burger{display:flex;}
  }

  /* ---------- hero ---------- */
  .hero{
    position:relative;
    background:linear-gradient(180deg,var(--ink) 0%, var(--ink-2) 100%);
    color:var(--paper);
    padding:96px 0 0;
    overflow:hidden;
  }
  .hero::before{
    content:"";position:absolute;inset:0;
    background-image:
      linear-gradient(var(--line) 1px, transparent 1px),
      linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size:64px 64px;
    mask-image:linear-gradient(180deg, rgba(0,0,0,.55), transparent 70%);
    opacity:.5;
    pointer-events:none;
  }
  .hero-grid{
    position:relative;z-index:2;
    display:grid;grid-template-columns:1.15fr .85fr;gap:40px;
    align-items:end;
  }
  @media(max-width:980px){.hero-grid{grid-template-columns:1fr;}}
  .hero-copy{padding-bottom:64px;}
  .hero-copy .eyebrow{margin-bottom:22px;}
  .hero h1{
    font-size:clamp(40px,6vw,74px);
    color:var(--paper);
  }
  .hero h1 em{
    font-style:normal;color:var(--gold);
  }
  .hero p.lede{
    margin-top:26px;max-width:480px;color:var(--slate);
    font-size:16.5px;line-height:1.65;
  }
  .hero-actions{display:flex;align-items:center;gap:26px;margin-top:38px;flex-wrap:wrap;}
  .btn-primary{
    background:var(--red);color:#fff;padding:15px 30px;border-radius:2px;
    font-family:var(--mono);font-size:12.5px;letter-spacing:.09em;text-transform:uppercase;
    border:1px solid var(--red);transition:all .25s;display:inline-flex;align-items:center;gap:10px;
  }
  .btn-primary:hover{background:var(--red-2);border-color:var(--red-2);transform:translateY(-1px);}
  .btn-ghost{
    color:var(--paper);font-family:var(--mono);font-size:12.5px;letter-spacing:.06em;text-transform:uppercase;
    border-bottom:1px solid var(--line);padding-bottom:4px;transition:border-color .25s,color .25s;
  }
  .btn-ghost:hover{border-color:var(--gold);color:var(--gold);}

  .hero-photos{
    position:relative;height:420px;
  }
  .hero-photos img{
    position:absolute;object-fit:cover;border:6px solid var(--ink);box-shadow:0 30px 60px -20px rgba(0,0,0,.6);
  }
  .hero-photos .p1{width:74%;height:320px;right:0;bottom:0;z-index:2;border-radius:3px;}
  .hero-photos .p2{width:52%;height:220px;left:0;top:0;z-index:3;border-radius:3px;}
  .hero-stat{
    position:absolute;left:0;bottom:-1px;z-index:4;
    background:var(--gold);color:var(--ink);padding:16px 20px;
    font-family:var(--mono);
  }
  .hero-stat b{display:block;font-family:var(--display);font-size:30px;line-height:1;}
  .hero-stat span{font-size:10px;letter-spacing:.1em;text-transform:uppercase;}
  @media(max-width:980px){
    .hero-photos{height:320px;margin-top:40px;}
  }
  @media(max-width:560px){
    .hero-photos{height:260px;}
    .hero-stat{position:static;margin-top:14px;display:inline-block;}
  }

  .hero-strip{
    position:relative;z-index:2;
    border-top:1px solid var(--line);
    margin-top:70px;
    display:grid;grid-template-columns:repeat(4,1fr);
  }
  .hero-strip div{
    padding:22px 40px;border-right:1px solid var(--line);
    font-family:var(--mono);font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--slate);
  }
  .hero-strip div b{display:block;color:var(--paper);font-family:var(--display);font-size:22px;text-transform:none;letter-spacing:0;margin-bottom:4px;}
  .hero-strip div:last-child{border-right:0;}
  @media(max-width:820px){
    .hero-strip{grid-template-columns:repeat(2,1fr);}
    .hero-strip div{padding:18px 22px;}
  }

  /* ---------- section shell ---------- */
  section{padding:112px 0;position:relative;}
  @media(max-width:720px){section{padding:72px 0;}}
  .section-head{display:flex;justify-content:space-between;align-items:flex-end;gap:40px;margin-bottom:56px;}
  .section-head h2{font-size:clamp(30px,4vw,46px);}
  .section-head p{max-width:340px;color:#5b5f6e;font-size:14.5px;line-height:1.6;}
  @media(max-width:760px){.section-head{flex-direction:column;align-items:flex-start;gap:16px;}}

  /* ---------- about ---------- */
  .about{background:var(--paper);}
  .about-grid{display:grid;grid-template-columns:.9fr 1.1fr;gap:64px;align-items:center;}
  @media(max-width:900px){.about-grid{grid-template-columns:1fr;}}
  .about-copy p{font-size:17px;line-height:1.75;color:#33384a;margin-bottom:20px;}
  .about-copy p:first-of-type{font-family:var(--display);font-size:23px;font-weight:500;color:var(--ink);line-height:1.4;}
  .about-media{position:relative;border-radius:3px;overflow:hidden;}
  .about-media img{width:100%;height:100%;object-fit:cover;filter:saturate(1.02);}
  .about-media::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,transparent 55%, rgba(11,21,48,.55));}
  .about-tag{
    position:absolute;bottom:18px;left:18px;color:#fff;font-family:var(--mono);
    font-size:11px;letter-spacing:.1em;text-transform:uppercase;z-index:2;
  }

  /* ---------- services rail (portfolio-style) ---------- */
  .services{background:var(--ink);color:var(--paper);}
  .services .section-head h2{color:var(--paper);}
  .services .section-head p{color:var(--slate);}
  .rail{
    display:flex;gap:22px;overflow-x:auto;padding-bottom:20px;scroll-snap-type:x mandatory;
    scrollbar-width:none;
  }
  .rail::-webkit-scrollbar{display:none;}
  .rail-card{
    flex:0 0 300px;scroll-snap-align:start;
    background:var(--ink-2);border:1px solid var(--line);border-radius:3px;overflow:hidden;
    transition:transform .35s var(--ease),border-color .35s;
  }
  .rail-card:hover{transform:translateY(-6px);border-color:var(--gold);}
  .rail-card .rc-img{height:190px;overflow:hidden;position:relative;}
  .rail-card .rc-img img{width:100%;height:100%;object-fit:cover;transition:transform .6s var(--ease);}
  .rail-card:hover .rc-img img{transform:scale(1.06);}
  .rail-card .rc-num{
    position:absolute;top:14px;left:14px;font-family:var(--mono);font-size:11px;
    background:rgba(11,21,48,.7);color:var(--gold);padding:4px 9px;border-radius:2px;letter-spacing:.08em;
  }
  .rail-card .rc-body{padding:20px 20px 24px;}
  .rail-card h3{font-size:19px;margin-bottom:6px;}
  .rail-card .rc-loc{font-family:var(--mono);font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:var(--slate);margin-bottom:12px;}
  .rail-card p{font-size:13.5px;line-height:1.6;color:#c3c8d6;}
  .rail-more{
    display:flex;justify-content:center;margin-top:44px;
  }

  /* ---------- credentials / trust grid (awards-style) ---------- */
  .credentials{background:var(--paper);}
  .cred-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--line-dark);border:1px solid var(--line-dark);}
  @media(max-width:860px){.cred-grid{grid-template-columns:repeat(2,1fr);}}
  @media(max-width:560px){.cred-grid{grid-template-columns:1fr;}}
  .cred-item{background:var(--paper);padding:34px 30px;min-height:210px;display:flex;flex-direction:column;justify-content:space-between;transition:background .3s;}
  .cred-item:hover{background:#fff;}
  .cred-item .cred-icon{
    width:40px;height:40px;border:1px solid var(--ink);border-radius:50%;
    display:flex;align-items:center;justify-content:center;font-family:var(--display);color:var(--red);font-size:16px;
  }
  .cred-item h4{font-family:var(--display);font-size:18px;margin-top:22px;font-weight:500;}
  .cred-item .cred-meta{font-family:var(--mono);font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--red);margin-top:8px;}
  .cred-item .cred-desc{font-size:13px;color:#5b5f6e;margin-top:10px;line-height:1.55;}

  /* ---------- solutions (services detail w/ tabs) ---------- */
  .solutions{background:var(--paper-dim);}
  .sol-grid{display:grid;grid-template-columns:.95fr 1.05fr;gap:60px;align-items:start;}
  @media(max-width:940px){.sol-grid{grid-template-columns:1fr;}}
  .sol-collage{position:relative;display:grid;grid-template-columns:1.3fr .9fr;grid-template-rows:auto auto;gap:14px;}
  .sol-collage img{width:100%;height:100%;object-fit:cover;border-radius:3px;}
  .sol-collage .sc-a{grid-row:1/3;height:100%;}
  .sol-collage .sc-b, .sol-collage .sc-c{height:190px;}
  @media(max-width:560px){.sol-collage{grid-template-columns:1fr;}.sol-collage .sc-a{height:220px;}}

  .tabs{display:flex;gap:8px;margin-bottom:30px;flex-wrap:wrap;}
  .tab-btn{
    font-family:var(--mono);font-size:12px;letter-spacing:.06em;text-transform:uppercase;
    padding:11px 18px;border:1px solid var(--line-dark);border-radius:2px;background:transparent;
    cursor:pointer;color:#5b5f6e;transition:all .25s;
  }
  .tab-btn.active{background:var(--ink);border-color:var(--ink);color:#fff;}
  .tab-panel{display:none;}
  .tab-panel.active{display:block;animation:fadein .5s var(--ease);}
  @keyframes fadein{from{opacity:0;transform:translateY(6px);}to{opacity:1;transform:translateY(0);}}
  .tab-panel h3{font-size:28px;margin-bottom:16px;}
  .tab-panel p{font-size:15.5px;line-height:1.75;color:#3c4152;margin-bottom:20px;}
  .tab-panel ul{list-style:none;display:grid;gap:10px;margin-top:22px;}
  .tab-panel ul li{
    font-size:13.5px;color:#3c4152;padding-left:20px;position:relative;
  }
  .tab-panel ul li::before{content:"";position:absolute;left:0;top:7px;width:9px;height:2px;background:var(--red);}

  /* ---------- why need us (stats/reasons) ---------- */
  .why{background:var(--ink);color:var(--paper);}
  .why .section-head h2{color:var(--paper);}
  .why .section-head p{color:var(--slate);}
  .why-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--line);border:1px solid var(--line);}
  @media(max-width:900px){.why-grid{grid-template-columns:repeat(2,1fr);}}
  @media(max-width:520px){.why-grid{grid-template-columns:1fr;}}
  .why-item{background:var(--ink-2);padding:32px 26px;min-height:170px;}
  .why-item .wi-n{font-family:var(--mono);color:var(--gold);font-size:12px;letter-spacing:.08em;}
  .why-item h4{font-size:17px;margin-top:16px;font-weight:500;line-height:1.35;}

  /* ---------- CEO ---------- */
  .ceo{background:var(--paper);}
  .ceo-grid{display:grid;grid-template-columns:.7fr 1.3fr;gap:60px;align-items:center;}
  @media(max-width:860px){.ceo-grid{grid-template-columns:1fr;}}
  .ceo-photo{position:relative;}
  .ceo-photo img{width:100%;border-radius:3px;filter:grayscale(.15);}
  .ceo-photo .ceo-frame{position:absolute;inset:-14px;border:1px solid var(--gold);border-radius:3px;pointer-events:none;}
  .ceo-name{margin-top:20px;}
  .ceo-name b{font-family:var(--display);font-size:18px;display:block;}
  .ceo-name span{font-family:var(--mono);font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--red);}
  .ceo-quote{font-family:var(--display);font-size:clamp(22px,2.6vw,30px);font-weight:400;line-height:1.5;color:var(--ink);}
  .ceo-quote span{color:var(--red);font-size:44px;font-family:var(--display);vertical-align:-14px;margin-right:4px;}
  .ceo-copy p{margin-top:22px;font-size:15px;line-height:1.75;color:#3c4152;}

  /* ---------- partners marquee ---------- */
  .partners{background:var(--paper);border-top:1px solid var(--line-dark);border-bottom:1px solid var(--line-dark);padding:56px 0;}
  .partners .section-head{margin-bottom:34px;}
  .marquee{overflow:hidden;position:relative;}
  .marquee::before,.marquee::after{
    content:"";position:absolute;top:0;bottom:0;width:80px;z-index:2;
  }
  .marquee::before{left:0;background:linear-gradient(90deg,var(--paper),transparent);}
  .marquee::after{right:0;background:linear-gradient(270deg,var(--paper),transparent);}
  .marquee-track{display:flex;align-items:center;gap:64px;width:max-content;animation:scroll 34s linear infinite;}
  @keyframes scroll{from{transform:translateX(0);}to{transform:translateX(-50%);}}
  .marquee-track span{
    font-family:var(--display);font-size:20px;color:#9a9fb0;letter-spacing:.02em;
    white-space:nowrap;transition:color .3s;
  }
  .marquee-track span:hover{color:var(--ink);}

  /* ---------- contact / cta ---------- */
  .cta{background:var(--ink);color:var(--paper);text-align:left;}
  .cta-grid{display:grid;grid-template-columns:1.2fr .8fr;gap:50px;}
  @media(max-width:860px){.cta-grid{grid-template-columns:1fr;}}
  .cta h2{font-size:clamp(32px,5vw,58px);color:var(--paper);max-width:640px;}
  .cta p.lede{color:var(--slate);margin-top:22px;max-width:460px;font-size:16px;line-height:1.7;}
  .contact-card{background:var(--ink-2);border:1px solid var(--line);border-radius:3px;padding:34px;}
  .contact-row{display:flex;gap:16px;padding:16px 0;border-bottom:1px solid var(--line);}
  .contact-row:last-child{border-bottom:0;}
  .contact-row .cr-label{font-family:var(--mono);font-size:10.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--gold);width:90px;flex-shrink:0;padding-top:2px;}
  .contact-row .cr-value{font-size:14.5px;line-height:1.6;color:var(--paper);}
  .contact-row .cr-value a:hover{color:var(--gold);}

  /* ---------- footer ---------- */
  footer{background:var(--ink-2);color:var(--slate);border-top:1px solid var(--line);}
  .foot-top{padding:70px 0 50px;display:grid;grid-template-columns:1.3fr 1fr 1fr 1fr;gap:40px;}
  @media(max-width:860px){.foot-top{grid-template-columns:1fr 1fr;}}
  @media(max-width:520px){.foot-top{grid-template-columns:1fr;}}
  .foot-brand{display:flex;align-items:center;gap:12px;margin-bottom:18px;}
  .foot-brand img{height:36px;}
  .foot-brand b{font-family:var(--display);color:var(--paper);font-size:16px;}
  footer p{font-size:13px;line-height:1.7;max-width:280px;}
  footer h5{
    font-family:var(--mono);font-size:11px;letter-spacing:.1em;text-transform:uppercase;
    color:var(--paper);margin-bottom:18px;
  }
  footer ul{list-style:none;display:grid;gap:10px;}
  footer ul li a{font-size:13.5px;transition:color .25s;}
  footer ul li a:hover{color:var(--gold);}
  .foot-bottom{
    border-top:1px solid var(--line);padding:22px 0;display:flex;justify-content:space-between;
    font-family:var(--mono);font-size:11px;letter-spacing:.04em;color:#5f6580;flex-wrap:wrap;gap:10px;
  }

  /* ---------- admin nav button ---------- */
  .nav-admin{
    background:transparent;color:var(--slate);border:1px solid var(--line);
    padding:9px 14px;border-radius:2px;font-family:var(--mono);font-size:11px;
    letter-spacing:.06em;text-transform:uppercase;cursor:pointer;transition:all .25s;
  }
  .nav-admin:hover{color:var(--paper);border-color:var(--gold);}
  .nav-admin.is-active{background:var(--gold);border-color:var(--gold);color:var(--ink);}

  /* ---------- service carousel ---------- */
  .rail-wrap{position:relative;padding:0 54px;}
  @media(max-width:640px){.rail-wrap{padding:0 40px;}}
  .rail-wrap .rail{overflow:hidden;scroll-snap-type:none;}
  .rail-wrap .rail-track-inner{display:flex;gap:22px;transition:transform .55s var(--ease);}
  .rail-arrow{
    position:absolute;top:50%;transform:translateY(-50%);z-index:5;
    width:40px;height:40px;border-radius:50%;border:1px solid var(--line);
    background:var(--ink-2);color:var(--paper);font-size:20px;cursor:pointer;
    display:flex;align-items:center;justify-content:center;transition:all .25s;
  }
  .rail-arrow:hover{border-color:var(--gold);color:var(--gold);}
  .rail-arrow.left{left:0;}
  .rail-arrow.right{right:0;}
  .rail-dots{display:flex;justify-content:center;gap:8px;margin-top:26px;}
  .rail-dots button{
    width:8px;height:8px;border-radius:50%;border:0;background:var(--line);cursor:pointer;padding:0;transition:background .25s,transform .25s;
  }
  .rail-dots button.active{background:var(--gold);transform:scale(1.25);}

  .rc-img{position:relative;}
  .rc-admin{position:absolute;top:12px;right:12px;display:flex;gap:6px;z-index:4;}
  .rc-btn{
    width:28px;height:28px;border-radius:50%;border:1px solid rgba(255,255,255,.3);
    background:rgba(11,21,48,.75);color:#fff;font-size:13px;cursor:pointer;
    display:flex;align-items:center;justify-content:center;transition:all .2s;
  }
  .rc-btn:hover{background:var(--gold);color:var(--ink);border-color:var(--gold);}
  .rc-btn.del:hover{background:var(--red-2);border-color:var(--red-2);color:#fff;}

  .add-card{
    flex:0 0 300px;border:1.5px dashed var(--line);border-radius:3px;
    display:flex;align-items:center;justify-content:center;cursor:pointer;
    min-height:326px;transition:border-color .25s,background .25s;
  }
  .add-card:hover{border-color:var(--gold);background:rgba(207,157,52,.06);}
  .add-inner{text-align:center;color:var(--slate);}
  .add-inner span{display:block;font-size:34px;color:var(--gold);line-height:1;margin-bottom:8px;}
  .add-inner small{font-family:var(--mono);font-size:11px;letter-spacing:.08em;text-transform:uppercase;}

  /* ---------- partner admin grid ---------- */
  .partner-admin-grid{display:flex;flex-wrap:wrap;gap:16px;margin-top:10px;}
  .partner-chip{
    position:relative;width:158px;background:#fff;border:1px solid var(--line-dark);
    border-radius:3px;padding:18px 14px 16px;text-align:center;transition:box-shadow .25s;
  }
  .partner-chip:hover{box-shadow:0 10px 24px -12px rgba(11,21,48,.25);}
  .partner-chip .pc-logo{
    width:56px;height:56px;border-radius:50%;margin:0 auto 10px;object-fit:cover;
    background:var(--paper-dim);display:flex;align-items:center;justify-content:center;overflow:hidden;
    font-family:var(--display);font-size:20px;color:var(--red);
  }
  .partner-chip .pc-logo img{width:100%;height:100%;object-fit:cover;}
  .partner-chip .pc-name{font-size:12.5px;color:var(--ink);line-height:1.35;}
  .partner-chip .rc-admin{top:8px;right:8px;}
  .partner-chip .rc-btn{width:24px;height:24px;font-size:11px;}
  .partner-chip.add-card{width:158px;min-height:126px;flex:0 0 auto;}

  /* ---------- modal ---------- */
  .modal-overlay{
    position:fixed;inset:0;background:rgba(9,14,30,.72);backdrop-filter:blur(3px);
    display:none;align-items:center;justify-content:center;z-index:200;padding:24px;
  }
  .modal-overlay.open{display:flex;}
  .modal-box{
    background:var(--paper);border-radius:4px;max-width:460px;width:100%;
    max-height:88vh;overflow-y:auto;padding:32px;position:relative;
    box-shadow:0 40px 80px -20px rgba(0,0,0,.5);
  }
  .modal-box h3{font-size:22px;margin-bottom:22px;}
  .modal-close{
    position:absolute;top:16px;right:16px;background:none;border:0;font-size:20px;
    cursor:pointer;color:#8892ab;width:30px;height:30px;
  }
  .field{margin-bottom:18px;}
  .field label{
    display:block;font-family:var(--mono);font-size:10.5px;letter-spacing:.08em;
    text-transform:uppercase;color:#5b5f6e;margin-bottom:7px;
  }
  .field input[type=text], .field textarea{
    width:100%;border:1px solid var(--line-dark);border-radius:2px;padding:11px 12px;
    font-family:var(--body);font-size:14px;background:#fff;color:var(--ink);resize:vertical;
  }
  .field input[type=file]{width:100%;font-size:12.5px;}
  .field-preview{
    margin-top:10px;width:100%;height:130px;border-radius:2px;overflow:hidden;
    background:var(--paper-dim);display:flex;align-items:center;justify-content:center;
  }
  .field-preview img{width:100%;height:100%;object-fit:cover;}
  .modal-actions{display:flex;justify-content:space-between;align-items:center;margin-top:26px;gap:10px;flex-wrap:wrap;}
  .btn-save{
    background:var(--red);color:#fff;border:1px solid var(--red);padding:12px 24px;
    border-radius:2px;font-family:var(--mono);font-size:12px;letter-spacing:.06em;
    text-transform:uppercase;cursor:pointer;transition:background .25s;
  }
  .btn-save:hover{background:var(--red-2);}
  .btn-delete{
    background:transparent;color:var(--red);border:1px solid var(--red);padding:12px 20px;
    border-radius:2px;font-family:var(--mono);font-size:12px;letter-spacing:.06em;
    text-transform:uppercase;cursor:pointer;transition:all .25s;
  }
  .btn-delete:hover{background:var(--red);color:#fff;}
  .modal-hint{font-size:12px;color:#8892ab;margin-top:-10px;margin-bottom:18px;line-height:1.5;}

  /* ---------- admin bar ---------- */
  .admin-bar{
    position:fixed;left:0;right:0;bottom:0;z-index:150;
    background:var(--ink);color:var(--paper);border-top:1px solid var(--gold);
    padding:14px 26px;display:none;align-items:center;justify-content:space-between;
    gap:16px;flex-wrap:wrap;font-family:var(--mono);font-size:12px;letter-spacing:.03em;
    box-shadow:0 -10px 30px rgba(0,0,0,.35);
  }
  .admin-bar.open{display:flex;}
  .admin-bar__status{display:flex;align-items:center;gap:10px;text-transform:uppercase;letter-spacing:.08em;color:var(--gold);}
  .admin-bar__actions{display:flex;gap:10px;align-items:center;flex-wrap:wrap;}
  .admin-bar__actions button, .admin-bar__actions label{
    background:transparent;border:1px solid var(--line);color:var(--paper);
    padding:9px 16px;border-radius:2px;cursor:pointer;text-transform:uppercase;
    letter-spacing:.06em;font-family:var(--mono);font-size:11px;transition:all .25s;
  }
  .admin-bar__actions button:hover, .admin-bar__actions label:hover{border-color:var(--gold);color:var(--gold);}
  #logoutBtn{border-color:var(--red-2);color:var(--red-2);}
  #logoutBtn:hover{background:var(--red-2);color:#fff;}
  body.admin-on{padding-bottom:64px;}

  /* ---------- back to top / misc ---------- */
  ::selection{background:var(--gold);color:var(--ink);}
</style>
</head>
<body>

  <div class="ticker">
    <div class="ticker__track" id="tickerTrack"></div>
  </div>

  <header>
    <div class="nav">
      <a class="brand" href="#top">
        <img src="data:image/png;base64," alt="Khmer Victor Security Service crest">
        <span class="brand-text"><b>Khmer Victor</b><small>Security Service</small></span>
      </a>
      <nav class="links">
        <a href="#about">About</a>
        <a href="#services">Services</a>
        <a href="#credentials">Credentials</a>
        <a href="#why">Why Us</a>
        <a href="#contact" class="nav-cta">Get a quote</a>
        <button class="nav-admin" id="adminToggleBtn" type="button">🔒 Admin</button>
      </nav>
      <button class="burger" aria-label="menu"><span></span><span></span><span></span></button>
    </div>
  </header>

  <div id="seedBank" style="display:none" aria-hidden="true">
    <img id="seedWhy" src="data:image/jpeg;base64," alt="">
  </div>

  <main id="top">
    <!-- ============ HERO ============ -->
    <section class="hero" style="padding-top:80px;">
      <div class="wrap">
        <div class="hero-grid">
          <div class="hero-copy reveal">
            <span class="eyebrow">Licensed private security · Cambodia · Est. 2016</span>
            <h1>Protection built<br>for <em>every scale</em><br>of your risk.</h1>
            <p class="lede">From a single storefront guard to citywide dispatch coordination — Khmer Victor Security Service turns exposure into control, with a permanently manned dispatch center behind every post.</p>
            <div class="hero-actions">
              <a href="#contact" class="btn-primary">Request a security plan →</a>
              <a href="#services" class="btn-ghost">See our services</a>
            </div>
          </div>
          <div class="hero-photos reveal">
            <img class="p2" id="imgWelcome" src="data:image/jpeg;base64," alt="Khmer Victor guards on post in Phnom Penh">
            <img class="p1" id="imgTeam" src="data:image/jpeg;base64," alt="Khmer Victor Security guard team lineup">
            <div class="hero-stat">
              <b>400+</b>
              <span>Screened &amp; trained officers</span>
            </div>
          </div>
        </div>

        <div class="hero-strip reveal">
          <div><b>2016</b>Year Founded</div>
          <div><b>380</b>Guards on active site duty</div>
          <div><b>24/7</b>Dispatch center coverage</div>
          <div><b>15+</b>Corporate &amp; institutional clients</div>
        </div>
      </div>
    </section>

    <!-- ============ ABOUT ============ -->
    <section class="about" id="about">
      <div class="wrap">
        <div class="about-grid">
          <div class="about-media reveal">
            <img id="imgCover" src="data:image/jpeg;base64," alt="Khmer Victor Security officers saluting in front of Phnom Penh landmarks">
            <span class="about-tag">Independence Monument post · Phnom Penh</span>
          </div>
          <div class="about-copy reveal">
            <span class="eyebrow" style="color:var(--red);margin-bottom:18px;">About the company</span>
            <p>Khmer Victor Security Service Co., Ltd is a private security company founded in 2016 and duly registered in the same year.</p>
            <p>Set up in Cambodia with precise know-how in the installation and maintenance of security systems, the firm presently employs 380 persons across active sites and maintains a roster of some 400 screened and adequately trained officers.</p>
            <p>Every post stays in permanent contact with our dispatch center, backed by staff members capable of coping with any situation — day or night.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ SERVICES RAIL ============ -->
    <section class="services" id="services">
      <div class="wrap">
        <div class="section-head reveal">
          <h2>Our services</h2>
          <p>We serve clients on a 24/7 basis across four core service lines, each staffed by screened, trained personnel.</p>
        </div>
        <div class="rail-wrap reveal">
          <button class="rail-arrow left" id="railPrev" aria-label="Previous service">‹</button>
          <div class="rail" id="serviceTrack"></div>
          <button class="rail-arrow right" id="railNext" aria-label="Next service">›</button>
        </div>
        <div class="rail-dots" id="serviceDots"></div>
      </div>
    </section>

    <!-- ============ CREDENTIALS ============ -->
    <section class="credentials" id="credentials">
      <div class="wrap">
        <div class="section-head reveal">
          <h2>Legit &amp; compliant</h2>
          <p>Our entity is fully registered and compliant with the relevant Cambodian authorities.</p>
        </div>
        <div class="cred-grid reveal">
          <div class="cred-item">
            <div class="cred-icon">01</div>
            <div>
              <h4>Ministry of Interior</h4>
              <div class="cred-meta">License No. 966 · Issued 03/06/2016</div>
              <p class="cred-desc">Operating license for the provision of private security services in the Kingdom of Cambodia.</p>
            </div>
          </div>
          <div class="cred-item">
            <div class="cred-icon">02</div>
            <div>
              <h4>Certificate of Incorporation</h4>
              <div class="cred-meta">Reg. No. 00014387 · 01/07/2016</div>
              <p class="cred-desc">Ministry of Commerce registration as a Private Limited Company.</p>
            </div>
          </div>
          <div class="cred-item">
            <div class="cred-icon">03</div>
            <div>
              <h4>Tax Registration (VAT)</h4>
              <div class="cred-meta">TIN K002-901637755</div>
              <p class="cred-desc">General Department of Taxation registration, active since 08 July 2016.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ SOLUTIONS / TABS ============ -->
    <section class="solutions">
      <div class="wrap">
        <div class="sol-grid">
          <div class="sol-collage reveal">
            <img class="sc-a" src="data:image/jpeg;base64," alt="Security officer team">
            <img class="sc-b" src="data:image/jpeg;base64," alt="Guards saluting outside bank">
            <img class="sc-c" src="data:image/jpeg;base64," alt="Guards on city post">
          </div>
          <div class="reveal">
            <span class="eyebrow" style="color:var(--red);margin-bottom:22px;display:inline-flex;">What we deliver</span>
            <div class="tabs">
              <button class="tab-btn active" data-tab="t1">Deployment</button>
              <button class="tab-btn" data-tab="t2">Screening &amp; Training</button>
              <button class="tab-btn" data-tab="t3">Dispatch Control</button>
            </div>
            <div class="tab-panel active" id="t1">
              <h3>Site deployment, matched to risk</h3>
              <p>Guard, armed guard, bodyguard and training services are scoped around each site's actual exposure — footfall, cash handling, access points and hours of operation — rather than a one-size uniform posting.</p>
              <ul>
                <li>Static and roving posts for banks, offices, hospitals and retail</li>
                <li>Armed coverage for elevated-risk assets and transfers</li>
                <li>Close-protection detail for executives and events</li>
              </ul>
            </div>
            <div class="tab-panel" id="t2">
              <h3>Every officer is screened first</h3>
              <p>We maintain a roster of some 400 employees who have been screened and received adequate training before ever standing a post, with continuing in-house security training to keep standards current.</p>
              <ul>
                <li>Background screening prior to deployment</li>
                <li>Structured induction and refresher training</li>
                <li>Discipline and conduct standards aligned to Ministry of Interior rules</li>
              </ul>
            </div>
            <div class="tab-panel" id="t3">
              <h3>A dispatch center behind every post</h3>
              <p>Teams operate in permanent contact with our dispatch center, with staff capable of coping with any situation and responding to any client call within 24 hours.</p>
              <ul>
                <li>24/7 monitored contact with every deployed officer</li>
                <li>Rapid response coordination across sites</li>
                <li>Ongoing performance and incident review</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ WHY NEED US ============ -->
    <section class="why" id="why">
      <div class="wrap">
        <div class="section-head reveal">
          <h2>Why need us?</h2>
          <p>Outsourcing security is a decision that pays back in more than just coverage.</p>
        </div>
        <div class="why-grid reveal">
          <div class="why-item"><div class="wi-n">01</div><h4>Transferring risk</h4></div>
          <div class="why-item"><div class="wi-n">02</div><h4>Great service at a reasonable price</h4></div>
          <div class="why-item"><div class="wi-n">03</div><h4>Quick solution for any concern</h4></div>
          <div class="why-item"><div class="wi-n">04</div><h4>Lets you focus on what you do best</h4></div>
          <div class="why-item"><div class="wi-n">05</div><h4>Increased financial flexibility</h4></div>
          <div class="why-item"><div class="wi-n">06</div><h4>Improved HR workflow</h4></div>
          <div class="why-item"><div class="wi-n">07</div><h4>Increased productivity</h4></div>
          <div class="why-item"><div class="wi-n">08</div><h4>Starting up is a breeze</h4></div>
        </div>
      </div>
    </section>

    <!-- ============ CEO MESSAGE ============ -->
    <section class="ceo">
      <div class="wrap">
        <div class="ceo-grid">
          <div class="ceo-photo reveal">
            <img src="data:image/jpeg;base64," alt="Mr. Hou Chamnan, Founder and CEO of Khmer Victor Security Service">
            <div class="ceo-frame"></div>
            <div class="ceo-name">
              <b>Mr. Hou Chamnan</b>
              <span>Founder / CEO</span>
            </div>
          </div>
          <div class="ceo-copy reveal">
            <p class="ceo-quote"><span>&ldquo;</span>Our vision is to be a leading service provider in the private security industry, recognized by national and international clients for our highly effective and professional services.</p>
            <p>We achieve this through our core values of discipline, integrity, responsiveness, efficiency and customized service — and through the continuous trust and support of our clients, partners and team members. We understand that each client has unique needs, and we try our best to tailor our services to meet those needs.</p>
            <p>Thank you very much for choosing and trusting Khmer Victor Security Service.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ PARTNERS MARQUEE ============ -->
    <section class="partners">
      <div class="wrap">
        <div class="section-head reveal" style="margin-bottom:0;">
          <h2 style="font-size:26px;">Trusted by</h2>
          <p>So far, we have carried out projects for the following clients.</p>
        </div>
      </div>
      <div class="marquee" id="marqueeWrap" style="margin-top:30px;">
        <div class="marquee-track" id="marqueeTrack"></div>
      </div>
      <div class="wrap">
        <div class="partner-admin-grid" id="partnerAdminGrid" style="display:none;"></div>
      </div>
    </section>

    <!-- ============ CONTACT / CTA ============ -->
    <section class="cta" id="contact">
      <div class="wrap">
        <div class="cta-grid">
          <div class="reveal">
            <span class="eyebrow">Ready when you are</span>
            <h2 style="margin-top:22px;">Let's scope your<br>security plan.</h2>
            <p class="lede">Tell us about your site, hours and risk profile — we'll come back with a guard, armed guard, bodyguard or training plan built around it.</p>
          </div>
          <div class="contact-card reveal">
            <div class="contact-row">
              <div class="cr-label">Address</div>
              <div class="cr-value">#96A, St. 103, Sk. Phsar Deoum Thkov,<br>Khan Chamkar Mon, Phnom Penh, Kingdom of Cambodia</div>
            </div>
            <div class="contact-row">
              <div class="cr-label">Phone</div>
              <div class="cr-value">
                <a href="tel:+855095985666">095 985 666</a> /
                <a href="tel:+855087985666">087 985 666</a> /
                <a href="tel:+855068985666">068 985 666</a>
              </div>
            </div>
            <div class="contact-row">
              <div class="cr-label">Email</div>
              <div class="cr-value"><a href="mailto:kvss2016@gmail.com">kvss2016@gmail.com</a></div>
            </div>
            <div class="contact-row">
              <div class="cr-label">Website</div>
              <div class="cr-value"><a href="https://www.kvssecuritycambodia.com" target="_blank" rel="noopener">www.kvssecuritycambodia.com</a></div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer>
    <div class="wrap">
      <div class="foot-top">
        <div>
          <div class="foot-brand">
            <img src="data:image/png;base64," alt="Khmer Victor Security Service crest">
            <b>Khmer Victor<br>Security Service</b>
          </div>
          <p>Licensed private security guard, armed guard, bodyguard and training services, operating 24/7 from Phnom Penh, Kingdom of Cambodia.</p>
        </div>
        <div>
          <h5>Company</h5>
          <ul>
            <li><a href="#about">About</a></li>
            <li><a href="#services">Services</a></li>
            <li><a href="#credentials">Credentials</a></li>
            <li><a href="#why">Why us</a></li>
          </ul>
        </div>
        <div>
          <h5>Services</h5>
          <ul>
            <li><a href="#services">Security Guard</a></li>
            <li><a href="#services">Armed Guard</a></li>
            <li><a href="#services">Body Guard</a></li>
            <li><a href="#services">Security Training</a></li>
          </ul>
        </div>
        <div>
          <h5>Contact</h5>
          <ul>
            <li><a href="tel:+855095985666">095 985 666</a></li>
            <li><a href="mailto:kvss2016@gmail.com">kvss2016@gmail.com</a></li>
