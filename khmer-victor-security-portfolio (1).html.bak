        <span>Ministry of Interior No. 966 · Ministry of Commerce No. 00014387</span>
      </div>
    </div>
  </footer>

  <div class="modal-overlay" id="modalOverlay">
    <div class="modal-box" id="modalBox"></div>
  </div>

  <div class="admin-bar" id="adminBar">
    <span class="admin-bar__status"><span class="dot-live"></span> Admin mode — editing enabled</span>
    <div class="admin-bar__actions">
      <button type="button" id="exportBtn">Export changes (.json)</button>
      <label for="importInput">Import changes</label>
      <input type="file" id="importInput" accept="application/json" hidden>
      <button type="button" id="logoutBtn">Log out</button>
    </div>
  </div>

<script>
  // dispatch ticker content
  const tickerItems = [
    "KVS DISPATCH ACTIVE","24/7 COVERAGE","PHNOM PENH, KH","400+ SCREENED OFFICERS",
    "MOI LICENSE No.966","EST. 2016","GUARD · ARMED GUARD · BODYGUARD · TRAINING"
  ];
  const track = document.getElementById('tickerTrack');
  function buildTicker(){
    let html = '';
    for(let r=0;r<2;r++){
      tickerItems.forEach(t=>{ html += `<span><span class="dot-live"></span>${t}</span>`; });
    }
    track.innerHTML = html;
  }
  buildTicker();

  // ================= ADMIN-EDITABLE CONTENT SYSTEM =================
  const ADMIN_PASSWORD = "kvss-admin-2026"; // change this before publishing
  let isAdmin = false;

  const escapeHtml = (str='') => str.replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));

  const seed = {
    team:    document.getElementById('imgTeam').src,
    welcome: document.getElementById('imgWelcome').src,
    cover:   document.getElementById('imgCover').src,
    why:     document.getElementById('seedWhy').src,
  };

  let servicesData = [
    {img:seed.team,    tag:"Static & patrol · Commercial sites",   title:"Security Guard",    desc:"Uniformed officers for banks, offices, retail and industrial sites, coordinated through our dispatch center around the clock."},
    {img:seed.welcome, tag:"High-risk assets · Cash & valuables",  title:"Armed Guard",       desc:"Licensed, vetted officers for sites and transfers that carry elevated risk, deployed under strict ministry-compliant protocol."},
    {img:seed.cover,   tag:"Close protection · Executives & VIPs", title:"Body Guard",        desc:"Discreet, dedicated close-protection officers for executives, delegations and events, tailored to each client's schedule."},
    {img:seed.why,     tag:"Certification · In-house academy",    title:"Security Training", desc:"Structured training and assessment for our own officers and client-side teams, keeping skills and discipline current."}
  ];

  let partnersData = ["Hattha Bank","ACLEDA Bank","AEON Specialized Bank","Mega Leasing","Sathapana Bank","PHSME Specialized Bank","Farmer Finance","Mothers Financial Japan","ChildFund Cambodia","Bangkok Airways","VINCI Construction","CMED Construction","Pacific PP Hospital","Newa Insurance"]
    .map(name => ({name, img:null}));

  // ---------------- Services carousel ----------------
  let currentSlide = 0;
  const serviceTrack = document.getElementById('serviceTrack');
  const serviceDots = document.getElementById('serviceDots');

  function renderServices(){
    const cardsHtml = servicesData.map((s,i)=>`
      <div class="rail-card" data-idx="${i}">
        <div class="rc-img">
          <span class="rc-num">${String(i+1).padStart(2,'0')}</span>
          <img src="${s.img}" alt="${escapeHtml(s.title)}">
          ${isAdmin ? `<div class="rc-admin">
              <button class="rc-btn edit" data-action="edit-service" data-idx="${i}" title="Edit">✎</button>
              <button class="rc-btn del" data-action="del-service" data-idx="${i}" title="Remove">✕</button>
            </div>` : ''}
        </div>
        <div class="rc-body">
          <h3>${escapeHtml(s.title)}</h3>
          <div class="rc-loc">${escapeHtml(s.tag)}</div>
          <p>${escapeHtml(s.desc)}</p>
        </div>
      </div>`).join('');
    const addCard = isAdmin ? `<div class="rail-card add-card" data-action="add-service"><div class="add-inner"><span>+</span><small>Add service</small></div></div>` : '';
    serviceTrack.innerHTML = `<div class="rail-track-inner" id="railInner">${cardsHtml}${addCard}</div>`;

    const total = servicesData.length + (isAdmin ? 1 : 0);
    if(currentSlide > total-1) currentSlide = Math.max(0,total-1);
    serviceDots.innerHTML = Array.from({length: total}).map((_,i)=>`<button data-goto="${i}" class="${i===currentSlide?'active':''}"></button>`).join('');
    requestAnimationFrame(updateSlide);
  }

  function updateSlide(){
    const inner = document.getElementById('railInner');
    if(!inner) return;
    const card = inner.querySelector('.rail-card');
    if(!card) return;
    const step = card.offsetWidth + 22;
    inner.style.transform = `translateX(${-currentSlide*step}px)`;
    serviceDots.querySelectorAll('button').forEach((b,i)=>b.classList.toggle('active', i===currentSlide));
  }

  document.getElementById('railPrev').addEventListener('click', ()=>{
    const total = servicesData.length + (isAdmin?1:0);
    currentSlide = (currentSlide - 1 + total) % total;
    updateSlide();
    serviceDots.querySelectorAll('button').forEach((b,i)=>b.classList.toggle('active', i===currentSlide));
  });
  document.getElementById('railNext').addEventListener('click', ()=>{
    const total = servicesData.length + (isAdmin?1:0);
    currentSlide = (currentSlide + 1) % total;
    updateSlide();
    serviceDots.querySelectorAll('button').forEach((b,i)=>b.classList.toggle('active', i===currentSlide));
  });
  serviceDots.addEventListener('click', (e)=>{
    const btn = e.target.closest('button[data-goto]');
    if(!btn) return;
    currentSlide = parseInt(btn.dataset.goto,10);
    updateSlide();
  });
  window.addEventListener('resize', updateSlide);

  serviceTrack.addEventListener('click', (e)=>{
    const editBtn = e.target.closest('[data-action="edit-service"]');
    const delBtn  = e.target.closest('[data-action="del-service"]');
    const addBtn  = e.target.closest('[data-action="add-service"]');
    if(editBtn) openServiceModal(parseInt(editBtn.dataset.idx,10));
    if(delBtn){
      const idx = parseInt(delBtn.dataset.idx,10);
      if(confirm(`Remove "${servicesData[idx].title}" from services?`)){
        servicesData.splice(idx,1);
        renderServices();
      }
    }
    if(addBtn) openServiceModal(null);
  });

  // ---------------- Partners: public marquee + admin grid ----------------
  const marqueeWrap = document.getElementById('marqueeWrap');
  const mTrack = document.getElementById('marqueeTrack');
  const partnerAdminGrid = document.getElementById('partnerAdminGrid');

  function partnerLogoHtml(p){
    return p.img
      ? `<img src="${p.img}" alt="${escapeHtml(p.name)}">`
      : escapeHtml((p.name||'?').trim().charAt(0).toUpperCase());
  }

  function renderPartnersPublic(){
    let html = '';
    for(let r=0;r<2;r++){
      partnersData.forEach(p=>{
        html += p.img
          ? `<span style="display:inline-flex;align-items:center;gap:10px;"><img src="${p.img}" alt="${escapeHtml(p.name)}" style="width:26px;height:26px;border-radius:50%;object-fit:cover;">${escapeHtml(p.name)}</span>`
          : `<span>${escapeHtml(p.name)}</span>`;
      });
    }
    mTrack.innerHTML = html;
  }

  function renderPartnersAdmin(){
    const chips = partnersData.map((p,i)=>`
      <div class="partner-chip" data-idx="${i}">
        <div class="rc-admin">
          <button class="rc-btn edit" data-action="edit-partner" data-idx="${i}" title="Edit">✎</button>
          <button class="rc-btn del" data-action="del-partner" data-idx="${i}" title="Remove">✕</button>
        </div>
        <div class="pc-logo">${partnerLogoHtml(p)}</div>
        <div class="pc-name">${escapeHtml(p.name)}</div>
      </div>`).join('');
    const addChip = `<div class="partner-chip add-card" data-action="add-partner"><div class="add-inner"><span>+</span><small>Add partner</small></div></div>`;
    partnerAdminGrid.innerHTML = chips + addChip;
  }

  function renderPartners(){
    renderPartnersPublic();
    if(isAdmin) renderPartnersAdmin();
  }

  partnerAdminGrid.addEventListener('click', (e)=>{
    const editBtn = e.target.closest('[data-action="edit-partner"]');
    const delBtn  = e.target.closest('[data-action="del-partner"]');
    const addBtn  = e.target.closest('[data-action="add-partner"]');
    if(editBtn) openPartnerModal(parseInt(editBtn.dataset.idx,10));
    if(delBtn){
      const idx = parseInt(delBtn.dataset.idx,10);
      if(confirm(`Remove "${partnersData[idx].name}" from partners?`)){
        partnersData.splice(idx,1);
        renderPartners();
      }
    }
    if(addBtn) openPartnerModal(null);
  });

  // ---------------- Modal system ----------------
  const modalOverlay = document.getElementById('modalOverlay');
  const modalBox = document.getElementById('modalBox');
  function closeModal(){ modalOverlay.classList.remove('open'); modalBox.innerHTML=''; }
  modalOverlay.addEventListener('click', (e)=>{ if(e.target===modalOverlay) closeModal(); });

  function readFileAsDataUrl(file){
    return new Promise((resolve,reject)=>{
      const reader = new FileReader();
      reader.onload = () => resolve(reader.result);
      reader.onerror = reject;
      reader.readAsDataURL(file);
    });
  }

  function openServiceModal(idx){
    const editing = idx !== null;
    const s = editing ? servicesData[idx] : {img:'', tag:'', title:'', desc:''};
    modalBox.innerHTML = `
      <button class="modal-close" id="mClose">✕</button>
      <h3>${editing ? 'Edit service' : 'Add service'}</h3>
      <div class="field">
        <label>Photo (PNG or JPG)</label>
        <input type="file" id="fImg" accept=".png,.jpg,.jpeg,image/png,image/jpeg">
        <div class="field-preview" id="fPreview">${s.img ? `<img src="${s.img}">` : 'No photo yet'}</div>
      </div>
      <div class="field"><label>Title</label><input type="text" id="fTitle" value="${escapeHtml(s.title)}" placeholder="e.g. Armed Guard"></div>
      <div class="field"><label>Tag line</label><input type="text" id="fTag" value="${escapeHtml(s.tag)}" placeholder="e.g. High-risk assets · Cash & valuables"></div>
      <div class="field"><label>Description</label><textarea id="fDesc" rows="4" placeholder="Short description of this service">${escapeHtml(s.desc)}</textarea></div>
      <div class="modal-actions">
        <div>${editing ? `<button class="btn-delete" id="mDelete">Delete</button>` : ''}</div>
        <button class="btn-save" id="mSave">Save service</button>
      </div>`;
    modalOverlay.classList.add('open');
    let newImg = s.img;
    document.getElementById('fImg').addEventListener('change', async (e)=>{
      const file = e.target.files[0];
      if(!file) return;
      if(!/^image\/(png|jpe?g)$/.test(file.type)){ alert('Please choose a PNG or JPG file.'); return; }
      newImg = await readFileAsDataUrl(file);
      document.getElementById('fPreview').innerHTML = `<img src="${newImg}">`;
    });
    document.getElementById('mClose').addEventListener('click', closeModal);
    if(editing){
      document.getElementById('mDelete').addEventListener('click', ()=>{
        if(confirm(`Delete "${s.title}"?`)){ servicesData.splice(idx,1); closeModal(); renderServices(); }
      });
    }
    document.getElementById('mSave').addEventListener('click', ()=>{
      const title = document.getElementById('fTitle').value.trim();
      const tag = document.getElementById('fTag').value.trim();
      const desc = document.getElementById('fDesc').value.trim();
      if(!title || !newImg){ alert('Please add a title and a photo.'); return; }
      const entry = {img:newImg, tag, title, desc};
      if(editing) servicesData[idx] = entry; else servicesData.push(entry);
      closeModal();
      renderServices();
    });
  }

  function openPartnerModal(idx){
    const editing = idx !== null;
    const p = editing ? partnersData[idx] : {name:'', img:null};
    modalBox.innerHTML = `
      <button class="modal-close" id="mClose">✕</button>
      <h3>${editing ? 'Edit partner' : 'Add partner'}</h3>
      <div class="field"><label>Partner name</label><input type="text" id="fName" value="${escapeHtml(p.name)}" placeholder="e.g. ACLEDA Bank"></div>
      <div class="field">
        <label>Logo (PNG or JPG, optional)</label>
        <input type="file" id="fImg" accept=".png,.jpg,.jpeg,image/png,image/jpeg">
        <div class="field-preview" id="fPreview" style="height:100px;">${p.img ? `<img src="${p.img}">` : 'No logo — initial letter will show'}</div>
      </div>
      <div class="modal-actions">
        <div>${editing ? `<button class="btn-delete" id="mDelete">Delete</button>` : ''}</div>
        <button class="btn-save" id="mSave">Save partner</button>
      </div>`;
    modalOverlay.classList.add('open');
    let newImg = p.img;
    document.getElementById('fImg').addEventListener('change', async (e)=>{
      const file = e.target.files[0];
      if(!file) return;
      if(!/^image\/(png|jpe?g)$/.test(file.type)){ alert('Please choose a PNG or JPG file.'); return; }
      newImg = await readFileAsDataUrl(file);
      document.getElementById('fPreview').innerHTML = `<img src="${newImg}">`;
    });
    document.getElementById('mClose').addEventListener('click', closeModal);
    if(editing){
      document.getElementById('mDelete').addEventListener('click', ()=>{
        if(confirm(`Delete "${p.name}"?`)){ partnersData.splice(idx,1); closeModal(); renderPartners(); }
      });
    }
    document.getElementById('mSave').addEventListener('click', ()=>{
      const name = document.getElementById('fName').value.trim();
      if(!name){ alert('Please add a partner name.'); return; }
      const entry = {name, img:newImg};
      if(editing) partnersData[idx] = entry; else partnersData.push(entry);
      closeModal();
      renderPartners();
    });
  }

  // ---------------- Admin login / bar / export-import ----------------
  const adminToggleBtn = document.getElementById('adminToggleBtn');
  const adminBar = document.getElementById('adminBar');

  function openLoginModal(){
    modalBox.innerHTML = `
      <button class="modal-close" id="mClose">✕</button>
      <h3>Admin login</h3>
      <p class="modal-hint">Only the platform admin can edit services and partners. Enter the admin password to unlock editing.</p>
      <div class="field"><label>Password</label><input type="text" id="fPass" placeholder="Admin password"></div>
      <div class="modal-actions"><div></div><button class="btn-save" id="mSave">Log in</button></div>`;
    modalOverlay.classList.add('open');
    const submit = ()=>{
      const val = document.getElementById('fPass').value;
      if(val === ADMIN_PASSWORD){
        isAdmin = true;
        document.body.classList.add('admin-on');
        adminBar.classList.add('open');
        adminToggleBtn.textContent = '🔓 Admin ✓';
        adminToggleBtn.classList.add('is-active');
        closeModal();
        renderServices();
        renderPartners();
      } else {
        alert('Incorrect password.');
      }
    };
    document.getElementById('mClose').addEventListener('click', closeModal);
    document.getElementById('mSave').addEventListener('click', submit);
    document.getElementById('fPass').addEventListener('keydown', (e)=>{ if(e.key==='Enter') submit(); });
  }

  adminToggleBtn.addEventListener('click', ()=>{
    if(isAdmin) return; // use logout button in admin bar instead
    openLoginModal();
  });

  document.getElementById('logoutBtn').addEventListener('click', ()=>{
    isAdmin = false;
    document.body.classList.remove('admin-on');
    adminBar.classList.remove('open');
    adminToggleBtn.textContent = '🔒 Admin';
    adminToggleBtn.classList.remove('is-active');
    partnerAdminGrid.style.display = 'none';
    marqueeWrap.style.display = '';
    renderServices();
    renderPartners();
  });

  document.getElementById('exportBtn').addEventListener('click', ()=>{
    const payload = JSON.stringify({services:servicesData, partners:partnersData}, null, 2);
    const blob = new Blob([payload], {type:'application/json'});
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = 'kvss-site-content.json';
    a.click();
  });

  document.getElementById('importInput').addEventListener('change', async (e)=>{
    const file = e.target.files[0];
    if(!file) return;
    try{
      const text = await file.text();
      const data = JSON.parse(text);
      if(Array.isArray(data.services)) servicesData = data.services;
      if(Array.isArray(data.partners)) partnersData = data.partners;
      renderServices();
      renderPartners();
      alert('Content loaded.');
    }catch(err){
      alert('Could not read that file — please choose a valid exported .json file.');
    }
    e.target.value = '';
  });

  // watch admin state to toggle marquee vs admin grid visibility
  const _origRenderPartners = renderPartners;
  renderPartners = function(){
    _origRenderPartners();
    if(isAdmin){
      marqueeWrap.style.display = 'none';
      partnerAdminGrid.style.display = 'flex';
    } else {
      marqueeWrap.style.display = '';
      partnerAdminGrid.style.display = 'none';
    }
  };

  renderServices();
  renderPartners();

  // reveal on scroll
  const io = new IntersectionObserver((entries)=>{
    entries.forEach(e=>{
      if(e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target); }
    });
  },{threshold:.15});
  document.querySelectorAll('.reveal').forEach(el=>io.observe(el));

  // tabs
  document.querySelectorAll('.tab-btn').forEach(btn=>{
    btn.addEventListener('click', ()=>{
      document.querySelectorAll('.tab-btn').forEach(b=>b.classList.remove('active'));
      document.querySelectorAll('.tab-panel').forEach(p=>p.classList.remove('active'));
      btn.classList.add('active');
      document.getElementById(btn.dataset.tab).classList.add('active');
    });
  });

  // mobile burger -> scroll to contact links dropdown (simple toggle)
  const burger = document.querySelector('.burger');
  const links = document.querySelector('nav.links');
  burger.addEventListener('click', ()=>{
    const open = links.style.display === 'flex';
    links.style.display = open ? 'none' : 'flex';
    links.style.cssText += open ? '' : 'position:absolute;top:100%;left:0;right:0;background:var(--ink);flex-direction:column;padding:20px 22px;gap:18px;border-bottom:1px solid var(--line);';
  });
</script>
</body>
</html>
